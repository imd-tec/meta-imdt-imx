software =
{
    version = "1.0.0";

    @MACHINE@ =
    {
        hardware-compatibility: [ "1.0" ];

        @FILES_BLOCK@

        images:
        (
            {
                filename = "@TARFILE@";
                type = "archive";
                compressed = "@COMPRESSION_TYPE@";
                device = "/dev/update-root";
                filesystem = "ext4";
                path = "/";
            }
        );
        bootenv: (
            {
                name = "upgrade_available";
                value = "1";
            }
        );
        scripts:
        (
            {
                filename = "update.sh";
                type = "shellscript";
            }
        );
    };
};

